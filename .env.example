# ==============================================================================
# AICTE NEXUS INDIA | ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# National APAAR Command Center & Fraud Interception Grid
# Copy this file to .env and populate with production credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & GATEWAY SETTINGS
# ------------------------------------------------------------------------------
AICTE_ENV=production                    # production | staging | development
AICTE_HOST=0.0.0.0
AICTE_PORT=8501
AICTE_GATEWAY_PORT=8080
AICTE_DEBUG=false
AICTE_SECRET_KEY=generate_a_secure_random_256_bit_token_here

# ------------------------------------------------------------------------------
# 2. QUANTUM-SAFE SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Master AES-256-GCM symmetric encryption key for student PII vaults
AES_256_GCM_MASTER_KEY=4f9c8b7a6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c9b
# Merkle chain salt for deterministic SHA-256 block receipts
MERKLE_TREE_SALT=AICTE_NATIONAL_APEX_NEXUS_2026_SECURE
QUANTUM_SAFE_TLS_ENABLED=true
HSM_FIPS_LEVEL=FIPS_140_3_LEVEL_4

# ------------------------------------------------------------------------------
# 3. GRAPH NEURAL NETWORK (GNN) ENGINE
# ------------------------------------------------------------------------------
GNN_CONVOLUTION_MODEL=GraphSAGE-v5.0-Enterprise
GNN_SIMILARITY_THRESHOLD=0.82           # Cosine/Token set threshold (0.0 - 1.0)
GNN_MAX_HOPS=3                          # Neighborhood aggregation depth
GNN_INFERENCE_TARGET_MS=15              # Latency SLA ceiling in milliseconds

# ------------------------------------------------------------------------------
# 4. NEURAL RAG & REGULATORY COPILOT
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini                     # gemini | openai | local_ollama
GEMINI_API_KEY=your_google_ai_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here_if_using_openai
RAG_EMBEDDING_DIM=768
RAG_SIMILARITY_TOP_K=4
RAG_TEMPERATURE=0.1                     # Low temperature for strict factual adherence

# ------------------------------------------------------------------------------
# 5. INTER-MINISTERIAL API INTEGRATION BRIDGES
# ------------------------------------------------------------------------------
# DigiLocker & National Academic Depository (NAD)
DIGILOCKER_NAD_CLIENT_ID=digilocker_aicte_central_prod
DIGILOCKER_NAD_API_KEY=dgl_live_99887766554433221100
DIGILOCKER_NAD_GATEWAY_URL=https://api.digitallocker.gov.in/v2/nad

# National Scholarship Portal (NSP 2.0 Direct Benefit Transfer)
NSP_DBT_CLIENT_ID=nsp_dbt_apex_aicte
NSP_DBT_BEARER_TOKEN=nsp_bearer_token_2026_live
NSP_DBT_GATEWAY_URL=https://scholarships.gov.in/api/v2/dbt-crosscheck

# UIDAI Aadhaar Vault Demographic Service
UIDAI_AADHAAR_VAULT_URL=https://uidai.gov.in/auth/v2.5/demographic
UIDAI_SUB_AUA_CODE=AICTE_EDC_AUA_8849

# ------------------------------------------------------------------------------
# 6. DATABASE & PERSISTENCE LAYER
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./apaar_ultimate_enterprise.db
# For PostgreSQL / Enterprise Relational Deployments:
# DATABASE_URL=postgresql+psycopg2://aicte_admin:secure_password@localhost:5432/aicte_nexus_db
REDIS_CACHE_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. ROLE-BASED ACCESS CONTROL (RBAC) SEED TOKENS
# ------------------------------------------------------------------------------
CENTRAL_ADMIN_PASSPHRASE=AICTE_CENTRAL_CMD_2026
REGISTRAR_NODE_TOKEN=AICTE_REGISTRAR_ERP_SECURE
SYSTEM_AUDITOR_PASSPHRASE=CERTIN_AUDIT_CLEARANCE_LVL3
